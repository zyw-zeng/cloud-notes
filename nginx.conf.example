# ========================================
# Cloud Notes Nginx 反向代理配置示例
# ========================================
# 使用说明：
# 1. 将此文件复制到 /etc/nginx/conf.d/cloud-notes.conf
# 2. 修改 server_name 为你的域名或IP
# 3. 测试配置: nginx -t
# 4. 重启Nginx: systemctl restart nginx
# ========================================

server {
    listen 80;
    server_name your-domain.com;  # 修改为你的域名或服务器IP

    # 日志配置
    access_log /www/wwwlogs/cloud-notes-access.log;
    error_log /www/wwwlogs/cloud-notes-error.log;

    # 客户端请求体大小限制（用于文件上传）
    client_max_body_size 10M;

    # 反向代理到Spring Boot应用
    location / {
        proxy_pass http://127.0.0.1:8080;
        
        # 请求头设置
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # WebSocket支持
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        
        # 超时设置
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        
        # 缓冲设置
        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
        proxy_busy_buffers_size 8k;
    }

    # Swagger UI 静态资源缓存
    location ~* ^/swagger-ui/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        expires 7d;
        add_header Cache-Control "public, immutable";
    }

    # API文档缓存
    location ~* ^/v3/api-docs {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        expires 1h;
    }

    # 静态资源缓存（如果有）
    location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg|woff|woff2|ttf|eot)$ {
        proxy_pass http://127.0.0.1:8080;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # 健康检查端点（不记录日志）
    location /actuator/health {
        proxy_pass http://127.0.0.1:8080;
        access_log off;
    }

    # 禁止访问隐藏文件
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
}

